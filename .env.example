PORT=8086
# WebDAV login (leave empty for open local dev; set both in production).
#DAV_USER=slsk
#DAV_PASS=change-me
# rclone storage backend: TeraBox remote holding an ndus cookie.
#RCLONE_BIN=rclone
#RCLONE_CONFIG=/root/.config/rclone/rclone.conf
#RCLONE_REMOTE=terabox:
#RCLONE_TIMEOUT_MS=60000
# Remote subtree exposed as WebDAV root.
#RCLONE_BASE_PATH=/
# JSON persistence for locks + dead props across restarts (empty = memory only).
#PROP_STORE=./webdav-state.json
# Max lock lifetime granted (seconds).
#LOCK_TIMEOUT_MAX=86400
