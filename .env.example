PORT=8086
# WebDAV login (leave empty for open local dev; set both in production).
#DAV_USER=slsk
#DAV_PASS=change-me
# terabox-gateway base URL (holds your TeraBox ndus cookie).
TERABOX_GATEWAY_URL=http://localhost:5000
# Share catalog: "Label|https://teraboxshare.com/s/XXXX" entries, comma-separated.
# Labels become top-level WebDAV collections.
TERABOX_SHARES=
# GET mode: redirect (302 to gateway short link, zero bandwidth) or pipe
# (stream bytes through this server, forwards Range; costs bandwidth).
#PROXY_MODE=redirect
